{
  "compilerOptions": {
    "target": "ES2020",                          // modern output (faster, smaller)
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "module": "ESNext",
    "moduleResolution": "Node",
    "resolveJsonModule": true,
    "isolatedModules": true,

    "jsx": "react-jsx",
    "noEmit": true,

    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,                     // warns for unused vars
    "noUnusedParameters": true,                 // warns for unused args
    "useUnknownInCatchVariables": false         // optional: easier error handling
  },
  "include": ["src"]
}
