# .env

# Base API URL for your backend
VITE_API_URL=https://api.example.com

# Auth token key for localStorage/sessionStorage
VITE_AUTH_TOKEN_KEY=auth_token

# Other optional environment values
VITE_APP_NAME=React Admin Panel
VITE_DEFAULT_LANG=en

REACT_APP_API_BASE_URL=https://your-api-url.com/api


# ⚠️ Note:

# Use VITE_ prefix for variables if you’re using Vite.

# If using Create React App (CRA), replace VITE_ with REACT_APP_.

